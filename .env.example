# QLOO API Key (Optional: CULTURA runs 100% offline with zero keys using built-in mock catalog)
QLOO_API_KEY=your_qloo_api_key_here

# Optional: Live Qloo Hackathon Endpoint Configuration
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional: Execution Mode (set to true to force deterministic offline mock cache)
QLOO_USE_MOCK=false
REQUEST_TIMEOUT_SECONDS=10.0
